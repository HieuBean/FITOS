# =============================================================================
# FITOS GYM CRM & SAAS PLATFORM - ENVIRONMENT VARIABLES (TEMPLATE)
#
# Sao chép file này thành `.env` rồi điền giá trị thật:
#     cp .env.example .env
#
# KHÔNG commit file `.env` (đã nằm trong .gitignore).
# Mọi giá trị bên dưới chỉ là mẫu — hãy đổi trước khi triển khai.
# =============================================================================

# --- APPLICATION PORTS ---
BACKEND_PORT=8080
FRONTEND_PORT=3000
AI_CRM_PORT=8001
AI_COMMERCE_PORT=8002
AI_OPERATIONS_PORT=8003
AI_WORKOUT_PORT=8004

# --- SPRING BOOT BACKEND ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitos_db
DB_USER=postgres
DB_PASSWORD=change-me-database-password
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# Redis Cache & Sessions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
# Sinh khoá mới (>= 32 byte) bằng:
#     openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRATION_MS=86400000

# --- AI MICROSERVICES GATEWAY & KEYS ---
# Token nội bộ giữa backend và các dịch vụ AI — phải khớp ở cả hai phía.
AI_SERVICE_TOKEN=change-me-shared-internal-token

AI_CRM_URL=http://localhost:8001
AI_CRM_API_KEY=change-me-ai-crm-key

AI_COMMERCE_URL=http://localhost:8002
AI_COMMERCE_API_KEY=change-me-ai-commerce-key

AI_OPERATIONS_URL=http://localhost:8003
AI_OPERATIONS_API_KEY=change-me-ai-operations-key

AI_WORKOUT_URL=http://localhost:8004
AI_WORKOUT_API_KEY=change-me-ai-workout-key

# OpenAI & External LLMs
# Để trống nếu chạy chế độ rule-based (không gọi LLM bên ngoài).
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- NEXT.JS FRONTEND ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME="FITOS - Gym Management OS"
